# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI backend: Groq (https://console.groq.com/keys).
# Local development only: set VITE_GROQ_API_KEY and the browser calls Groq directly.
# Never set it in a production build - it would be visible to anyone using the site.
VITE_GROQ_API_KEY=

# Production (Vercel): leave VITE_GROQ_API_KEY empty and set GROQ_API_KEY (no VITE_ prefix)
# in the Vercel project settings. The app then calls /api/model and /api/speech.
# GROQ_API_KEY=

# Alternative production backend: Firebase Cloud Functions (see /functions). Set this to use it.
# VITE_AI_BACKEND=firebase

# Giphy Stickers API key (https://developers.giphy.com). Fun stickers in video lessons.
# Safe to use in the browser; the lesson still plays without stickers if it is empty.
VITE_GIPHY_API_KEY=

# Optional: Google Images for the real pictures/diagrams in video lessons.
# 1) Enable "Custom Search API" in Google Cloud and create an API key.
# 2) Create a Programmable Search Engine at https://programmablesearchengine.google.com,
#    turn on "Search the entire web" and "Image search", and copy its Search engine ID (cx).
# Free tier: 100 searches/day. If left empty, pictures come from Wikipedia / Wikimedia Commons (no key).
VITE_GOOGLE_CSE_KEY=
VITE_GOOGLE_CSE_CX=

# Optional: real random sound effects from Freesound (https://freesound.org/apiv2/apply).
# Without it the player uses built-in synthesized sounds (whoosh, pop, chime).
VITE_FREESOUND_API_KEY=
