# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI backend: Groq (https://console.groq.com/keys).
# Local development only: set VITE_GROQ_API_KEY and the browser calls Groq directly.
# Never set it in a production build - it would be visible to anyone using the site.
VITE_GROQ_API_KEY=

# Production (Vercel): leave VITE_GROQ_API_KEY empty and set GROQ_API_KEY (no VITE_ prefix)
# in the Vercel project settings. The app then calls /api/model and /api/speech.
# GROQ_API_KEY=

# Alternative production backend: Firebase Cloud Functions (see /functions). Set this to use it.
# VITE_AI_BACKEND=firebase

# Giphy Stickers API key (https://developers.giphy.com). Used for the visuals in video lessons.
# Safe to use in the browser; the lesson still plays without stickers if it is empty.
VITE_GIPHY_API_KEY=
