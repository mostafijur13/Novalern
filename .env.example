# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI backend: Groq (https://console.groq.com/keys).
# Production: leave VITE_GROQ_API_KEY empty and deploy the Cloud Function in /functions
# (the key stays on the server as a Firebase secret named GROQ_API_KEY).
# Local development only: set a key here and the browser calls Groq directly.
# Never ship a build with this value set - it would be visible to anyone using the site.
VITE_GROQ_API_KEY=

# Giphy Stickers API key (https://developers.giphy.com). Used for the visuals in video lessons.
# Safe to use in the browser; the lesson still plays without stickers if it is empty.
VITE_GIPHY_API_KEY=
